#!/usr/bin/env bash
# ==============================================================================
# OpenCode (standalone) - Optional PPQ Private Mode Proxy Service
# ==============================================================================

export HOME="/data"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CONFIG_HOME="/data/.config"
export NODE_OPTIONS="--max-old-space-size=256"
export PORT="8787"

if [ -f /data/.env_vars ]; then
    source /data/.env_vars
fi

PPQ_PRIVATE_ENABLED="${PPQ_PRIVATE_ENABLED:-false}"

if [ "${PPQ_PRIVATE_ENABLED}" != "true" ]; then
    exec sleep infinity
fi

if [ -z "${PPQ_API_KEY:-}" ]; then
    echo "ERROR: PPQ private mode is enabled, but no PPQ_API_KEY is configured." >&2
    echo "ERROR: set PPQ_API_KEY, then restart the container." >&2
    exec sleep infinity
fi

echo "Starting PPQ private-mode proxy on 127.0.0.1:${PORT}"
echo "The PPQ proxy is internal-only and is not exposed on any published port."

# ppq-private-mode is installed into the image's global modules
# (/usr/local/lib/node_modules). This script sources /data/.env_vars, which
# exports NPM_CONFIG_PREFIX=/data/.npm-global so anything the user installs by
# hand persists — so a plain `npm root -g` would resolve there and miss the proxy
# (ERR_MODULE_NOT_FOUND). Isolate the lookup from that override.
PPQ_PROXY_ENTRYPOINT="$(unset NPM_CONFIG_PREFIX npm_config_prefix; npm root -g)/ppq-private-mode/bin/server.ts"

if [ ! -f "${PPQ_PROXY_ENTRYPOINT}" ]; then
    echo "ERROR: PPQ proxy entrypoint not found at ${PPQ_PROXY_ENTRYPOINT}" >&2
    exec sleep infinity
fi

exec tsx "${PPQ_PROXY_ENTRYPOINT}"
