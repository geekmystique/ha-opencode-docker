# Copy this file to .env and fill in at least the "Home Assistant connection"
# section. See README.md for the full walkthrough.

# --- Build --------------------------------------------------------------
# amd64 or aarch64 (matches `uname -m`'s aarch64, not Docker's arm64)
BUILD_ARCH=amd64

# --- Where things live on the host ---------------------------------------
# Your real Home Assistant config directory (the one with configuration.yaml).
HA_CONFIG_DIR=./ha-config

# --- Home Assistant connection (required) ---------------------------------
# Base URL of your running Home Assistant Core - no trailing slash, no /api.
# Examples: http://homeassistant.local:8123  http://192.168.1.10:8123
HA_URL=http://homeassistant.local:8123
# A Long-Lived Access Token: Home Assistant -> your profile (click your user
# icon, bottom left) -> scroll to "Long-Lived Access Tokens" -> Create Token.
# This replaces the Supervisor-injected token the HA-OS add-on gets for free;
# it is what every HA-facing tool (config validation, entity/service calls,
# screenshots, LSP entity completion, home context) authenticates with here.
HA_ACCESS_TOKEN=
# Set to false only if HA_URL uses a self-signed/untrusted TLS certificate.
HA_VERIFY_SSL=true

# --- Presentation -----------------------------------------------------------
# terminal (ttyd web shell) or openchamber (graphical web UI)
INTERFACE_MODE=terminal
TERMINAL_THEME=breeze
FONT_SIZE=14
CURSOR_STYLE=block
CURSOR_BLINK=false
FOCUS_MODE=false

# --- Front door (replaces Home Assistant Ingress) --------------------------
# Internal + published port for the terminal/OpenChamber UI.
FRONTDOOR_PORT=8099
# Both required to turn on HTTP Basic Auth. Leave both empty ONLY if this
# port never leaves localhost or a fully trusted network - there is no other
# login in front of it standalone. See README.md "Security" for options.
WEB_USERNAME=
WEB_PASSWORD=

# --- MCP / features ----------------------------------------------------------
MCP_ENABLED=true
# compact | configuration | full - smaller profiles mean a cheaper prompt and
# a narrower blast radius, useful with smaller/local models.
MCP_TOOL_PROFILE=full
LSP_ENABLED=true
# Requires HA_ACCESS_TOKEN. Uses headless Chromium to screenshot dashboards.
SCREENSHOT_ENABLED=false
# Optional bridge to Home Assistant Core's native /api/mcp/<API ID> endpoint
# (Home Assistant >= 2026.8). Independent of MCP_ENABLED above.
NATIVE_HA_MCP_ENABLED=false
NATIVE_HA_MCP_API_ID=assist
# Home context: what OpenCode knows about this installation before you type.
HOME_BRIEFING_ENABLED=true
DECISION_NOTES_ENABLED=true

# --- Access control -----------------------------------------------------
# Deny OpenCode read access to secret files (secrets.yaml, .storage, .cloud,
# ssl, *.key, *.pem). Set to false for fully unrestricted file access.
RESTRICT_SENSITIVE_FILES=true
# Only meaningful if you've bind-mounted extra folders like /addons or
# /addon_configs in docker-compose.yml (see the commented-out lines there) -
# most standalone setups will leave this false.
ADDON_ACCESS_ENABLED=false

# --- Runtime --------------------------------------------------------------
# auto (detect) | baseline (older CPUs) | regular (force AVX2)
CPU_MODE=auto

# --- opencode attach (optional LAN server, off by default) ----------------
ENABLE_SERVER=false
# Comma-separated browser origins allowed to call the LAN server directly
# (CORS). Only needed for browser-based clients; the OpenCode CLI does not
# need this. Example: https://my-web-ui.example.com,http://localhost:3000
CORS_ORIGINS=

# --- Model providers --------------------------------------------------------
# PPQ private mode (beta): routes OpenCode through a local encryption proxy
# for TEE-backed models. Requires a PPQ API key.
PPQ_PRIVATE_ENABLED=false
PPQ_API_KEY=

# --- Optional hardware ------------------------------------------------------
# Zigbee2MQTT (manual only - there is no Supervisor to auto-discover it from).
# Include http:// or https://; host/IP-only values are treated as http://.
Z2M_URL=
Z2M_MQTT_TOPIC=zigbee2mqtt
# Colon-separated device paths. List the same paths under `devices:` in
# docker-compose.yml so Docker actually maps them into the container.
SERIAL_DEVICES=

# --- Advanced ---------------------------------------------------------------
# Custom OpenCode configuration as a raw JSON string, merged over the
# generated opencode.json. See https://opencode.ai/docs/config
OPENCODE_CONFIG_JSON=
# Run your own .sh scripts from <HA_CONFIG_DIR>/opencode/startup.d at every
# start. These scripts run as root, so this explicit opt-in stays last.
USER_HOOKS_ENABLED=false
